# Discord Developer Portal -> Applications -> (bot lo) -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=
# (Opsional) ID server buat testing. Kalau diisi, slash command langsung muncul di server ini.
# Kalau kosong, command didaftarkan global (bisa butuh beberapa menit).
GUILD_ID=

# Volume awal tiap queue baru (1-150)
DEFAULT_VOLUME=60

# ---------- yt-dlp ----------
# (Opsional) Path/command yt-dlp. Kosong = bot download sendiri ke folder bin/ dan auto-update tiap start.
# Kalau lo install lewat winget, isi: YTDLP_PATH=yt-dlp
YTDLP_PATH=
# Update yt-dlp bawaan (bin/) otomatis tiap bot start. Isi false buat matiin.
YTDLP_AUTO_UPDATE=true
# Cara streaming: pipe (default, yt-dlp yang download lalu di-pipe ke FFmpeg; anti HTTP 403)
# atau direct (FFmpeg buka URL YouTube langsung; lebih ringan tapi bisa kena 403)
YTDLP_STREAM_MODE=pipe
# (Opsional) Path cookies.txt YouTube (format Netscape) buat video yang minta login / "confirm you're not a bot".
# Contoh: YT_COOKIES_PATH=./cookies.txt   — JANGAN di-commit, pakai akun Google cadangan.
YT_COOKIES_PATH=

# ---------- FFmpeg ----------
# (Opsional) Path ffmpeg.exe kalau nggak ada di PATH. Contoh: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Isi true buat log debug DisTube di console
DEBUG=false
